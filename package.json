{
  "name": "dsh-subagent-custom-dispatch",
  "version": "0.1.0",
  "description": "Identity-based subagent dispatch for DeepSeek Harness: one dispatch tool, per-identity model routes, main-model-visible dispatch rules, and child briefs hidden from the main model.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.jpg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.jpg",
    "README.md",
    "README.en.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "subagent",
    "dispatch"
  ],
  "license": "MIT"
}
